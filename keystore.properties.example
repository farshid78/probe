# این فایل را به keystore.properties تغییر نام دهید و مقادیر واقعی را فقط روی رایانه خودتان وارد کنید.
# فایل .jks و این فایل رمزدار را هرگز برای دیگران ارسال یا در ZIP/Git منتشر نکنید.
storeFile=bastehyab-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=bastehyab
keyPassword=YOUR_KEY_PASSWORD
