name: Source archive, JVM checks and Android build

on:
  push:
    branches: [ '**' ]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  SOURCE_ZIP: Bastehyab-Obsidian-1.8.2-source.zip
  EXTRACT_DIR: bastehyab-work/bastehyab-fix
  JAVA_VERSION: '17'
  GRADLE_VERSION: '8.13'
  # Monotonic per workflow; the protected-release job also verifies it against the
  # previous release's version-code.txt. Avoids reusing the already-released code 1.
  BH_VERSION_CODE: ${{ github.run_number }}
  # SHA-256 of the committed PUBLIC CI preview keystore. Both jobs verify it
  # before use, so substituted signing material cannot slip into a release.
  PREVIEW_KEY_SHA256: 1f1bc6fbf04fefdb6e92a5879837263a74aac4b6b63e434906c0760b6b36b0b2

jobs:
  verify:
    name: Verify archive, JVM smokes, Lint and unit tests
    runs-on: ubuntu-latest
    steps:
      - name: Check out this branch
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Set up JDK 17
        uses: actions/setup-java@c5195efecf7bdfc987ee8bae7a71cb8b11521c00 # v4.7.1
        with:
          distribution: temurin
          java-version: ${{ env.JAVA_VERSION }}

      - name: Verify the single source archive and extract it
        id: source
        shell: bash
        run: |
          set -euo pipefail
          archives=(*.zip)
          [[ ${#archives[@]} -eq 1 && "${archives[0]}" == "$SOURCE_ZIP" ]] || {
            echo "Expected exactly one source archive named $SOURCE_ZIP"; exit 1; }
          python3 - <<'PY'
          import hashlib, zipfile, os, sys
          name = os.environ['SOURCE_ZIP']
          extract = os.environ['EXTRACT_DIR']
          with zipfile.ZipFile(name) as z:
              bad = [n for n in z.namelist()
                     if n.startswith('/') or '..' in n.split('/') or n.startswith(extract + '/../')]
              if bad: sys.exit('Unsafe ZIP paths: ' + repr(bad[:5]))
              roots = {n.split('/')[0] for n in z.namelist() if n and not n.endswith('/')}
              if roots != {'bastehyab-work'}:
                  sys.exit('Unexpected archive roots: ' + repr(roots))
              z.extractall('.')
          print('SHA256: ' + hashlib.sha256(open(name, 'rb').read()).hexdigest())
          print('Entries: ' + str(len(zipfile.ZipFile(name).namelist())))
          PY
          # Python's ZipFile.extractall() does not restore Unix mode bits.
          chmod +x "$EXTRACT_DIR/gradlew"
          find "$EXTRACT_DIR/tools" -type f -name '*.sh' -exec chmod +x {} +
          [[ -f "$EXTRACT_DIR/settings.gradle" ]]
          [[ -f "$EXTRACT_DIR/gradle/wrapper/gradle-wrapper.jar" ]]
          [[ -f "$EXTRACT_DIR/app/src/main/java/app/bastehyab/ScanService.java" ]]
          [[ -f "$EXTRACT_DIR/app/src/main/res/values/strings.xml" ]]
          [[ -f "$EXTRACT_DIR/tools/run-all-checks.sh" ]]
          echo "source=$EXTRACT_DIR" >> "$GITHUB_OUTPUT"
      - name: Verify Gradle wrapper and pinned action references
        shell: bash
        run: |
          set -euo pipefail
          cd "$EXTRACT_DIR"
          test "$(sha256sum gradle/wrapper/gradle-wrapper.jar | cut -d' ' -f1)" = \
            81a82aaea5abcc8ff68b3dfcb58b3c3c429378efd98e7433460610fecd7ae45f
          grep -q 'distributionSha256Sum=20f1b1176237254a6fc204d8434196fa11a4cfb387567519c61556e8710aed78' \
            gradle/wrapper/gradle-wrapper.properties
          grep -q 'gradle-8.13-bin.zip' gradle/wrapper/gradle-wrapper.properties
          grep -q "version '8.11.1'" build.gradle
          grep -q 'compileSdk 36' app/build.gradle
          grep -q "1.9.0" app/build.gradle
      - name: Verify the committed public CI preview signing key
        shell: bash
        run: |
          set -euo pipefail
          cd "$EXTRACT_DIR"
          printf '%s  ci-preview.p12\n' "$PREVIEW_KEY_SHA256" | sha256sum -c -
          test -f ci-preview.p12
          grep -q '^storeFile=ci-preview.p12$' ci-preview.properties.example
      - name: Regenerate resource JVM doubles and run all plain-JVM checks
        shell: bash
        run: |
          set -euo pipefail
          cd "$EXTRACT_DIR"
          bash tools/run-all-checks.sh
      - name: Validate the AAPT resource graph, font tables and monochrome icon
        shell: bash
        run: |
          set -euo pipefail
          cd "$EXTRACT_DIR"
          # Static pre-flight; the authoritative AAPT2 link runs in :app:assembleDebug below.
          bash tools/resource-validation/run.sh
      - name: Set up Android SDK 36
        uses: android-actions/setup-android@9fc6c4e9069bf8d3d10b2204b1fb8f6ef7065407 # v3.2.2
        with:
          packages: 'platforms;android-36 build-tools;35.0.0 platform-tools'

      - name: Set up Gradle 8.13
        uses: gradle/actions/setup-gradle@0bdd871935719febd78681f197cd39af5b6e16a6 # v4.2.2
        with:
          gradle-version: ${{ env.GRADLE_VERSION }}
          cache-read-only: ${{ github.event_name != 'push' }}

      - name: Android Lint, JVM unit tests and Debug APK
        shell: bash
        working-directory: ${{ steps.source.outputs.source }}
        run: |
          set -euo pipefail
          ./gradlew --no-daemon --stacktrace :app:lintDebug :app:testDebugUnitTest :app:assembleDebug
      - name: Build and verify an installable signed Release APK
        shell: bash
        working-directory: ${{ steps.source.outputs.source }}
        run: |
          set -euo pipefail
          trap 'rm -f keystore.properties' EXIT
          printf '%s  ci-preview.p12\n' "$PREVIEW_KEY_SHA256" | sha256sum -c -
          cp ci-preview.properties.example keystore.properties
          chmod 600 keystore.properties
          ./gradlew --no-daemon --stacktrace :app:assembleRelease
          apk_dir=app/build/outputs/apk/release
          mapfile -t apks < <(find "$apk_dir" -maxdepth 1 -type f -name '*.apk' | sort)
          [[ ${#apks[@]} -eq 1 ]] || {
            echo "Expected exactly one release APK in $apk_dir, found ${#apks[@]}" >&2; exit 1; }
          apk="${apks[0]}"
          case "$(basename "$apk")" in
            *unsigned*) echo "Refusing an unsigned APK: $apk" >&2; exit 1 ;;
          esac
          apksigner="$(command -v apksigner || true)"
          if [[ -z "$apksigner" ]]; then
            sdk_root="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}"
            [[ -n "$sdk_root" ]] || { echo 'ANDROID_HOME is not set' >&2; exit 1; }
            apksigner="$(find "$sdk_root/build-tools" -type f -name apksigner -print -quit)"
          fi
          [[ -n "$apksigner" ]] || { echo 'apksigner not found in Android build-tools' >&2; exit 1; }
          "$apksigner" verify --verbose "$apk"
          "$apksigner" verify --print-certs "$apk"
          artifact="Bastehyab-1.9.0-${BH_VERSION_CODE}-preview-sideload.apk"
          mkdir -p release-assets
          cp -- "$apk" "release-assets/$artifact"
          ( cd release-assets && sha256sum "$artifact" > apk-sha256.txt )
          echo "Verified installable APK: release-assets/$artifact"
      - name: Show full Lint text report on failure
        if: failure()
        shell: bash
        run: |
          report=$(find "$EXTRACT_DIR/app/build" -name 'lint-results-debug.txt' -type f -print -quit 2>/dev/null || true)
          if [[ -n "$report" ]]; then
            echo "===== $report ====="
            sed -n '1,260p' "$report"
          else
            echo "No lint text report was generated."
          fi
      - name: Upload Lint, test and Debug APK reports
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: android-verification-${{ github.run_number }}
          path: |
            ${{ steps.source.outputs.source }}/app/build/reports/**
            ${{ steps.source.outputs.source }}/app/build/test-results/**
            ${{ steps.source.outputs.source }}/app/build/outputs/apk/debug/*.apk
          if-no-files-found: warn
          retention-days: 14

      - name: Upload the verified signed Release APK
        if: success()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: installable-release-preview-${{ github.run_number }}
          path: |
            ${{ steps.source.outputs.source }}/release-assets/*.apk
            ${{ steps.source.outputs.source }}/release-assets/apk-sha256.txt
          if-no-files-found: error
          retention-days: 14

  protected-release:
    name: Release archive (protected default branch only)
    if: github.event_name == 'push' && github.ref == 'refs/heads/main' && github.repository == 'farshid78/probe'
    needs: verify
    runs-on: ubuntu-latest
    permissions:
      contents: write
    # Every published APK is signed and verified with apksigner. The four
    # repository secrets select the private production key; when they are absent
    # the job uses the committed PUBLIC preview key to build a clearly labelled,
    # installable sideload APK. An unsigned APK is never a release asset.
    env:
      KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
      KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
      KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
      KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
    steps:
      - name: Check out this branch
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Set up JDK 17
        uses: actions/setup-java@c5195efecf7bdfc987ee8bae7a71cb8b11521c00 # v4.7.1
        with:
          distribution: temurin
          java-version: ${{ env.JAVA_VERSION }}
      - name: Set up Android SDK 36
        uses: android-actions/setup-android@9fc6c4e9069bf8d3d10b2204b1fb8f6ef7065407 # v3.2.2
        with:
          packages: 'platforms;android-36 build-tools;35.0.0 platform-tools'
      - name: Set up Gradle 8.13
        uses: gradle/actions/setup-gradle@0bdd871935719febd78681f197cd39af5b6e16a6 # v4.2.2
        with:
          gradle-version: ${{ env.GRADLE_VERSION }}
      - name: Extract the verified source archive
        run: |
          unzip -q "$SOURCE_ZIP"
          chmod +x "$EXTRACT_DIR/gradlew"
      - name: Verify monotonic version code against the prior release
        id: version
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          cd "$EXTRACT_DIR"
          code="${BH_VERSION_CODE:-1}"
          [[ "$code" =~ ^[0-9]+$ && "$code" -ge 1 ]] || { echo 'BH_VERSION_CODE must be a positive integer'; exit 1; }
          export BH_VERSION_CODE="$code"
          gh api --paginate /repos/${{ github.repository }}/releases | jq -s 'add // []' > /tmp/releases.json
          python3 - <<'PY'
          import json, os, sys
          releases = json.load(open('/tmp/releases.json'))
          latest = next((r for r in releases if not r.get('draft')), None)
          if latest:
              from urllib.request import urlopen
              asset = next((a for a in latest.get('assets', []) if a['name'] == 'version-code.txt'), None)
              if asset:
                  previous = int(urlopen(asset['browser_download_url']).read().decode().strip())
                  current = int(os.environ.get('BH_VERSION_CODE', '1'))
                  if current <= previous:
                      sys.exit(f'versionCode {current} is not greater than released {previous}')
          PY
          echo "code=$code" >> "$GITHUB_OUTPUT"
      - name: Restore release signing material when the repository provides it
        if: env.KEYSTORE_BASE64 != ''
        shell: bash
        run: |
          set -euo pipefail
          cd "$EXTRACT_DIR"
          printf '%s' "$KEYSTORE_BASE64" | base64 -d > release.jks
          {
            echo "storeFile=release.jks"
            echo "storePassword=$KEYSTORE_PASSWORD"
            echo "keyAlias=$KEY_ALIAS"
            echo "keyPassword=$KEY_PASSWORD"
          } > keystore.properties
          chmod 600 keystore.properties release.jks
          echo 'BH_SIGNING_MODE=production' >> "$GITHUB_ENV"
      - name: Enable the public CI preview signing key for sideload builds
        if: env.KEYSTORE_BASE64 == ''
        shell: bash
        run: |
          set -euo pipefail
          cd "$EXTRACT_DIR"
          printf '%s  ci-preview.p12\n' "$PREVIEW_KEY_SHA256" | sha256sum -c -
          cp ci-preview.properties.example keystore.properties
          chmod 600 keystore.properties
          grep -q '^storeFile=ci-preview.p12$' keystore.properties
          echo 'BH_SIGNING_MODE=preview' >> "$GITHUB_ENV"
      - name: Build, verify and publish a signed APK with a professional asset name
        shell: bash
        env:
          BH_VERSION_CODE: ${{ steps.version.outputs.code }}
          BH_VERSION_NAME: '1.9.0'
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          cd "$EXTRACT_DIR"
          ./gradlew --no-daemon --stacktrace :app:assembleRelease
          # A Release build must produce exactly one signed APK. Gradle's default
          # app-release-unsigned.apk is rejected outright, never published.
          apk_dir=app/build/outputs/apk/release
          mapfile -t apks < <(find "$apk_dir" -maxdepth 1 -type f -name '*.apk' | sort)
          if [[ ${#apks[@]} -ne 1 ]]; then
            echo "Expected exactly one release APK in $apk_dir, found ${#apks[@]}:" >&2
            printf '  %s\n' "${apks[@]}" >&2
            exit 1
          fi
          apk="${apks[0]}"
          case "$(basename "$apk")" in
            *unsigned*) echo "Refusing to publish an unsigned APK: $apk" >&2; exit 1 ;;
          esac
          apksigner="$(command -v apksigner || true)"
          if [[ -z "$apksigner" ]]; then
            sdk_root="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}"
            [[ -n "$sdk_root" ]] || { echo 'ANDROID_HOME is not set' >&2; exit 1; }
            apksigner="$(find "$sdk_root/build-tools" -type f -name apksigner -print -quit)"
          fi
          [[ -n "$apksigner" ]] || { echo 'apksigner not found in Android build-tools' >&2; exit 1; }
          "$apksigner" verify --verbose "$apk"
          case "${BH_SIGNING_MODE:-}" in
            production) label='release' ; summary='the private production signing key' ;;
            preview) label='preview-sideload' ; summary='the PUBLIC CI preview / sideload key' ;;
            *) echo 'BH_SIGNING_MODE was not selected by a signing step' >&2; exit 1 ;;
          esac
          artifact="Bastehyab-${BH_VERSION_NAME}-${BH_VERSION_CODE}-${label}.apk"
          mkdir -p release-assets
          cp -- "$apk" "release-assets/$artifact"
          printf '%s\n' "$BH_VERSION_CODE" > release-assets/version-code.txt
          {
            echo "Bastehyab ${BH_VERSION_NAME} (${BH_VERSION_CODE})"
            echo "source commit: ${{ github.sha }}"
            echo "signing mode: ${BH_SIGNING_MODE} (${summary})"
            echo "signature verification: apksigner verify --verbose (passed)"
            echo
            "$apksigner" verify --print-certs "$apk"
          } > release-assets/signing-info.txt
          ( cd release-assets && sha256sum "$artifact" > apk-sha256.txt )
          cat > release-notes.md <<EOF
          Automated release from the verified source archive ${{ github.sha }}.
          - APK: ${artifact} is signed, verified with apksigner and installable by sideloading.
          - Signing: ${summary} (mode ${BH_SIGNING_MODE}).
          - version-code.txt, apk-sha256.txt and signing-info.txt are attached for audit.
          - No unsigned APK is published by this workflow.
          EOF
          if [[ "$BH_SIGNING_MODE" == 'preview' ]]; then
            cat >> release-notes.md <<'EOF'
          > WARNING: this build is signed with the PUBLIC CI preview key committed
          > to the source archive. It is for testing and manual sideloading only,
          > not for Play or any official distribution. Configure KEYSTORE_BASE64,
          > KEYSTORE_PASSWORD, KEY_ALIAS and KEY_PASSWORD to publish a release
          > signed with your private production key.
          EOF
          fi
          gh release create "v${BH_VERSION_NAME}-${BH_VERSION_CODE}" \
            --repo "${{ github.repository }}" --title "Bastehyab ${BH_VERSION_NAME} (${BH_VERSION_CODE})" \
            --notes-file release-notes.md \
            release-assets/"$artifact" release-assets/version-code.txt \
            release-assets/apk-sha256.txt release-assets/signing-info.txt
      - name: Remove signing material from the runner
        if: always()
        shell: bash
        run: |
          cd "$EXTRACT_DIR"
          rm -f release.jks keystore.properties
