<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315"
                android:startColor="#FF142033" android:centerColor="#FF101825" android:endColor="#FF0B1220" />
        </shape>
    </item>
    <item android:gravity="top|end" android:width="360dp" android:height="360dp" android:right="-120dp" android:top="-150dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="260dp"
                android:centerColor="#224DE0C8" android:endColor="#004DE0C8" />
        </shape>
    </item>
    <item android:gravity="bottom|start" android:width="320dp" android:height="320dp" android:left="-110dp" android:bottom="-140dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="240dp"
                android:centerColor="#1E9C8CFF" android:endColor="#009C8CFF" />
        </shape>
    </item>
</layer-list>
