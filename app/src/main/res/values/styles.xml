<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/neu_primary_dark</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="AppDialog" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:colorAccent">@color/neu_primary_dark</item>
    </style>
</resources>
